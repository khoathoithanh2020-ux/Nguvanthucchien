        overlay.classList.add("hidden");
      }
    }

    function hashCode(str) {
      let hash = 0;
      for (let i = 0; i < str.length; i++) {
        hash = (hash << 5) - hash + str.charCodeAt(i);
        hash |= 0;
      }
      return "CACHE_KEY_" + Math.abs(hash);
    }

    function checkCachedAnswerKey() {
      const examText = document.getElementById("examContent").value.trim();
      const badge = document.getElementById("cacheStatusBadge");
      if (!examText) {
        badge.classList.add("hidden");
        return;
      }
      const cachedAnswer = localStorage.getItem(hashCode(examText));
      if (cachedAnswer) {
        document.getElementById("answerKeyContent").value = cachedAnswer;
        badge.classList.remove("hidden");
      } else {
        badge.classList.add("hidden");
      }
    }

    function saveCurrentAnswerKeyToCache() {
      const examText = document.getElementById("examContent").value.trim();
      const answerKey = document.getElementById("answerKeyContent").value.trim();
      if (examText && answerKey) {
        localStorage.setItem(hashCode(examText), answerKey);
      }
    }

    async function callGeminiAPI(payload, retries = 3, delay = 1000) {
      const apiKey = getApiKey();
      if (!apiKey) {
        toggleApiKeyModal(true);
        throw new Error("Vui lòng cấu hình Gemini API Key trước khi thực hiện!");
      }
      const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/${GEMINI_MODEL}:generateContent?key=${apiKey}`;
      for (let attempt = 0; attempt < retries; attempt++) {
        try {
          const response = await fetch(apiUrl, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload)
          });
          if (!response.ok) {
            const errData = await response.json();
            throw new Error(errData.error?.message || `Lỗi HTTP: ${response.status}`);
          }
          return await response.json();
        } catch (error) {
          if (attempt === retries - 1) throw error;
          await new Promise(res => setTimeout(res, delay * Math.pow(2, attempt)));
        }
      }
    }

    function cleanJsonText(rawText) {
      if (!rawText) return "";
      let cleaned = rawText.trim();
      if (cleaned.startsWith("```json")) cleaned = cleaned.replace(/^```json\s*/, "").replace(/\s*```$/, "");
      else if (cleaned.startsWith("```")) cleaned = cleaned.replace(/^```\s*/, "").replace(/\s*```$/, "");
      return cleaned.trim();
    }

    async function extractAnswerKeyAI() {
      const examText = document.getElementById("examContent").value.trim();
      if (!examText) {
        alert("Vui lòng nhập hoặc tải lên nội dung Đề bài trước!");
        return;
      }
      showLoading(true, "Hội đồng AI đang trích xuất đáp án chuẩn GDPT 2018...");
      const systemPrompt = `Bạn là Chuyên gia Ngữ văn GDPT 2018, Giáo sư - Tiến sĩ Khoa học với 50 năm kinh nghiệm. Lập HƯỚNG DẪN CHẤM VÀ ĐÁP ÁN CHI TIẾT.`;
      const payload = {
        contents: [{ role: "user", parts: [{ text: `ĐỀ BÀI:\n${examText}` }] }],
        systemInstruction: { parts: [{ text: systemPrompt }] }
      };
      try {
        const result = await callGeminiAPI(payload);
        const textOutput = result.candidates?.[0]?.content?.parts?.[0]?.text || "";
        document.getElementById("answerKeyContent").value = textOutput;
        saveCurrentAnswerKeyToCache();
        document.getElementById("cacheStatusBadge").classList.remove("hidden");
      } catch (err) {
        alert("Không thể trích xuất đáp án: " + err.message);
      } finally {
        showLoading(false);
      }
    }

    async function evaluateEssay() {
      const exam = document.getElementById("examContent").value.trim();
      const answerKey = document.getElementById("answerKeyContent").value.trim();
      const studentData = getCombinedStudentWork();
      const scope = document.getElementById("evalScopeSelect").value;
      const scoreI_Max = parseFloat(document.getElementById("scorePartI").value) || 0;
      const scoreII_Q1_Max = parseFloat(document.getElementById("scorePartII_Q1").value) || 0;
      const scoreII_Q2_Max = parseFloat(document.getElementById("scorePartII_Q2").value) || 0;

      if (!exam || !studentData.hasContent) {
        alert("Vui lòng nhập đầy đủ Đề bài và nội dung bài làm!");
        return;
      }

      const currentUser = JSON.parse(localStorage.getItem("YEU_VAN_HOC_CURRENT_USER") || "{}");
      let submissions = JSON.parse(localStorage.getItem("YEU_VAN_HOC_SUBMISSIONS") || "[]");
      submissions.push({
        userName: currentUser.name || "Học sinh",
        userRole: currentUser.role || "Học sinh",
        userEmail: currentUser.email || currentUser.username || "Ẩn danh",
        content: studentData.combinedText,
        scope: scope,
        timestamp: Date.now()
      });
      localStorage.setItem("YEU_VAN_HOC_SUBMISSIONS", JSON.stringify(submissions));
      syncDataWithCloud(); // Đồng bộ bài nộp lên đám mây ngay lập tức

      showLoading(true, "Hội đồng giám khảo AI đang tiến hành chấm bài...");
      const systemPrompt = `Chủ tịch Hội đồng chấm thi Ngữ văn GDPT 2018. Chấm bài làm học sinh chi tiết và trả về JSON chuẩn schema:
{
  "isOffTopic": boolean,
  "totalScore": number,
  "scorePartI": number,
  "scorePartII_Q1": number,
  "scorePartII_Q2": number,
  "gradeClassification": "Xuất sắc | Giỏi | Khá | Trung bình | Yếu | Liệt",
  "scoreSummaryText": "Tóm tắt tổng quan",
  "criteriaBreakdown": [{"section": "Tiêu chí", "feedback": "Nhận xét", "score": number, "maxScore": number}],
  "beforeParagraph": "Đoạn gốc",
  "afterParagraph": "Đoạn nâng cấp",
  "feedbackList": ["Lời khuyên"]
}`;

      const payload = {
        contents: [{ role: "user", parts: [{ text: `ĐỀ:\n${exam}\n\nĐÁP ÁN:\n${answerKey}\n\nBÀI LÀM:\n${studentData.combinedText}` }] }],
        systemInstruction: { parts: [{ text: systemPrompt }] },
        generationConfig: { responseMimeType: "application/json" }
      };

      try {
        const result = await callGeminiAPI(payload);
        const evalData = JSON.parse(cleanJsonText(result.candidates?.[0]?.content?.parts?.[0]?.text || ""));
        showLoading(false);
        renderResults(evalData, scoreI_Max, scoreII_Q1_Max, scoreII_Q2_Max, scope);
      } catch (err) {
        showLoading(false);
        alert("Lỗi chấm bài: " + err.message);
      }
    }

    function renderResults(data, maxI, maxII_Q1, maxII_Q2, scope) {
      const container = document.getElementById("resultContainer");
      container.classList.remove("hidden");
      document.getElementById("gradeBadge").innerText = (data.totalScore || 0).toFixed(2).replace(/\.00$/, '.0');
      document.getElementById("gradeClassification").innerText = data.gradeClassification || "Đánh giá";
      document.getElementById("scoreSummaryText").innerText = data.scoreSummaryText || "";
      document.getElementById("resDocHieu").innerText = `${(data.scorePartI || 0).toFixed(2)} / ${maxI}`;
      document.getElementById("resVietC1").innerText = `${(data.scorePartII_Q1 || 0).toFixed(2)} / ${maxII_Q1}`;
      document.getElementById("resVietC2").innerText = `${(data.scorePartII_Q2 || 0).toFixed(2)} / ${maxII_Q2}`;

      const tableBody = document.getElementById("evaluationTableBody");
      tableBody.innerHTML = "";
      if (Array.isArray(data.criteriaBreakdown)) {
        data.criteriaBreakdown.forEach(item => {
          const row = document.createElement("tr");
          row.className = "hover:bg-slate-800/50 transition";
          row.innerHTML = `<td class="py-3 px-3.5 font-bold text-slate-100">${item.section}</td><td class="py-3 px-3.5 text-slate-300">${item.feedback}</td><td class="py-3 px-3.5 text-right font-black text-emerald-400 font-mono">${item.score}/${item.maxScore}</td>`;
          tableBody.appendChild(row);
        });
      }
      document.getElementById("beforeParagraph").innerText = data.beforeParagraph || "";
      document.getElementById("afterParagraph").innerText = data.afterParagraph || "";
      const feedbackList = document.getElementById("feedbackList");
      feedbackList.innerHTML = "";
      if (Array.isArray(data.feedbackList)) {
        data.feedbackList.forEach(fb => {
          const li = document.createElement("li");
          li.innerText = fb;
          feedbackList.appendChild(li);
        });
      }
      lucide.createIcons();
      container.scrollIntoView({ behavior: 'smooth' });
    }

