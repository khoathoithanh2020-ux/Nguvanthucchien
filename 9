        return;
      }

      let registeredUsers = JSON.parse(localStorage.getItem("YEU_VAN_HOC_USERS") || "[]");
      const realIdx = idx - 1;
      if (realIdx >= 0 && realIdx < registeredUsers.length) {
        registeredUsers[realIdx].name = name;
