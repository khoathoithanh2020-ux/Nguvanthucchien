<!DOCTYPE html>
<html lang="vi" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>NGỮ VĂN THỰC CHIẾN - Trợ Lý Chấm Văn GDPT 2018 (Online Cloud Master)</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <!-- Libraries for File Parsing & Export: Mammoth (DOCX), PDF.js (PDF), Tesseract (OCR) & html2pdf -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/mammoth/1.6.0/mammoth.browser.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/2.16.105/pdf.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/tesseract.js@5/dist/tesseract.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Merriweather:ital,wght@0,300;0,400;0,700;1,300&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&family=Pacifico&display=swap" rel="stylesheet">

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            cyber: {
              bg: '#05070B',
              card: '#0D1322',
              border: '#1E293B',
              accent: '#10B981',
              neon: '#8B5CF6',
              amber: '#F59E0B',
              rose: '#F43F5E',
              cyan: '#06B6D4'
            }
          },
          fontFamily: {
            sans: ['Plus Jakarta Sans', 'sans-serif'],
            serif: ['Merriweather', 'serif'],
            brand: ['Pacifico', 'cursive']
          }
        }
      }
    }
  </script>
  <style>
    body {
      background-color: #05070B;
      background-image: 
        radial-gradient(circle at 10% 10%, rgba(139, 92, 246, 0.18) 0px, transparent 45%),
        radial-gradient(circle at 90% 90%, rgba(16, 185, 129, 0.18) 0px, transparent 45%),
        radial-gradient(circle at 50% 50%, rgba(6, 182, 212, 0.1) 0px, transparent 65%);
      background-attachment: fixed;
    }
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: #05070B; }
    ::-webkit-scrollbar-thumb { background: #1E293B; border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: #334155; }
    .glass-card {
      background: rgba(13, 19, 34, 0.82);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.1);
      box-shadow: 0 25px 60px rgba(0, 0, 0, 0.5);
    }
    .glass-input {
      background: rgba(5, 7, 11, 0.85);
      border: 1px solid rgba(255, 255, 255, 0.12);
      backdrop-filter: blur(10px);
    }
    .glass-input:focus {
      border-color: #10B981;
      box-shadow: 0 0 20px rgba(16, 185, 129, 0.3);
    }
    .neon-border-emerald {
      box-shadow: 0 0 25px -3px rgba(16, 185, 129, 0.4);
    }
    .glow-text-emerald {
      text-shadow: 0 0 15px rgba(16, 185, 129, 0.6);
    }
    .grid-pattern {
      background-size: 35px 35px;
      background-image: 
        linear-gradient(to right, rgba(255, 255, 255, 0.025) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
    }
  </style>
</head>
<body class="text-slate-100 min-h-screen font-sans antialiased flex flex-col grid-pattern">

  <!-- AUTH MODAL -->
  <div id="authModal" class="fixed inset-0 bg-black/90 backdrop-blur-2xl z-50 flex items-center justify-center p-4 hidden">
    <div class="glass-card border border-slate-700/80 rounded-3xl w-full max-w-lg p-8 shadow-2xl space-y-6">
      <div class="text-center space-y-2">
        <h2 class="font-black text-3xl bg-gradient-to-r from-amber-400 via-sky-300 to-indigo-400 bg-clip-text text-transparent">
          Cổng Đăng Nhập Hệ Thống
        </h2>
        <p class="text-xs text-amber-400 font-semibold italic">NGỮ VĂN THỰC CHIẾN - Cổng Xác Thực Đám Mây Trực Tuyến</p>
      </div>

      <div class="flex bg-slate-950 p-1.5 rounded-2xl border border-slate-800">
        <button type="button" onclick="switchAuthTab('login')" id="tabLoginBtn" class="flex-1 py-2 text-xs font-bold rounded-xl transition bg-emerald-600 text-white shadow-lg">Đăng Nhập</button>
        <button type="button" onclick="switchAuthTab('register')" id="tabRegisterBtn" class="flex-1 py-2 text-xs font-bold rounded-xl transition text-slate-400 hover:text-white">Đăng Ký Tài Khoản</button>
      </div>

      <div id="loginFormContainer" class="space-y-4">
        <div>
          <label class="block text-[11px] font-bold text-slate-300 mb-1">Tài khoản đăng nhập hoặc Gmail:</label>
          <input type="text" id="loginUsername" placeholder="Nhập 'Admin' hoặc email..." class="w-full glass-input rounded-xl px-4 py-3 text-xs text-slate-100 focus:outline-none">
        </div>
        <div>
          <label class="block text-[11px] font-bold text-slate-300 mb-1">Mật khẩu:</label>
          <div class="relative">
            <input type="password" id="loginPassword" placeholder="Nhập mật khẩu..." class="w-full glass-input rounded-xl px-4 py-3 text-xs text-slate-100 focus:outline-none pr-10">
            <button type="button" onclick="togglePasswordVisibility('loginPassword', 'eyeIconLogin')" class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-white">
              <i id="eyeIconLogin" data-lucide="eye" class="w-4 h-4"></i>
            </button>
          </div>
        </div>
        <div class="flex justify-end">
          <button type="button" onclick="handleForgotPassword()" class="text-[11px] text-amber-400 hover:underline font-semibold">Quên mật khẩu?</button>
        </div>
        <button type="button" onclick="handleLogin()" class="w-full py-3.5 bg-gradient-to-r from-emerald-500 to-teal-600 hover:opacity-95 text-white font-extrabold text-xs rounded-xl shadow-xl shadow-emerald-500/20 transition">
          TRUY CẬP ỨNG DỤNG
        </button>
      </div>

      <div id="registerFormContainer" class="space-y-3.5 hidden">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-[10px] font-bold text-slate-300 mb-1">Vai trò:</label>
            <select id="regRole" class="w-full glass-input rounded-xl px-3 py-2.5 text-xs text-slate-100 font-bold focus:outline-none">
              <option value="Học sinh">Học sinh</option>
              <option value="Giáo viên">Giáo viên</option>
            </select>
          </div>
          <div>
            <label class="block text-[10px] font-bold text-slate-300 mb-1">Năm sinh:</label>
            <input type="number" id="regYear" placeholder="Ví dụ: 2011" class="w-full glass-input rounded-xl px-3 py-2.5 text-xs text-slate-100 focus:outline-none">
          </div>
        </div>
        <div>
          <label class="block text-[10px] font-bold text-slate-300 mb-1">Họ và tên:</label>
          <input type="text" id="regName" placeholder="Ví dụ: Nguyễn Văn A" class="w-full glass-input rounded-xl px-3 py-2.5 text-xs text-slate-100 focus:outline-none">
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-[10px] font-bold text-slate-300 mb-1">Lớp:</label>
            <input type="text" id="regClass" placeholder="Ví dụ: 9A5" class="w-full glass-input rounded-xl px-3 py-2.5 text-xs text-slate-100 focus:outline-none">
          </div>
          <div>
            <label class="block text-[10px] font-bold text-slate-300 mb-1">Trường:</label>
            <input type="text" id="regSchool" placeholder="Ví dụ: THCS Trường Xuân" class="w-full glass-input rounded-xl px-3 py-2.5 text-xs text-slate-100 focus:outline-none">
          </div>
        </div>
        <div>
          <label class="block text-[10px] font-bold text-slate-300 mb-1">Tên tài khoản / Email đăng nhập:</label>
          <input type="text" id="regUsername" placeholder="Nhập tên đăng nhập hoặc email..." class="w-full glass-input rounded-xl px-3 py-2.5 text-xs text-slate-100 focus:outline-none">
        </div>
        <div>
          <label class="block text-[10px] font-bold text-slate-300 mb-1">Mật khẩu:</label>
          <div class="relative">
            <input type="password" id="regPassword" placeholder="Nhập mật khẩu..." class="w-full glass-input rounded-xl px-3 py-2.5 text-slate-100 focus:outline-none pr-10">
            <button type="button" onclick="togglePasswordVisibility('regPassword', 'eyeIconReg')" class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-white">
              <i id="eyeIconReg" data-lucide="eye" class="w-4 h-4"></i>
            </button>
          </div>
        </div>
        <button type="button" onclick="handleRegister()" class="w-full py-3.5 bg-gradient-to-r from-indigo-600 to-purple-600 hover:opacity-95 text-white font-extrabold text-xs rounded-xl shadow-xl shadow-indigo-600/20 transition">
          ĐĂNG KÝ NGAY (LƯU TRỮ TRỰC TUYẾN)
        </button>
      </div>

      <div class="relative flex py-1 items-center">
        <div class="flex-grow border-t border-slate-800"></div>
        <span class="flex-shrink mx-4 text-[10px] text-slate-400 uppercase tracking-widest font-bold">Hoặc</span>
        <div class="flex-grow border-t border-slate-800"></div>
      </div>

      <button type="button" onclick="handleGmailAuth()" class="w-full py-3 bg-slate-900 hover:bg-slate-800 border border-slate-700 text-slate-200 font-bold text-xs rounded-xl flex items-center justify-center gap-2.5 transition shadow-md">
        <svg class="w-4 h-4" viewBox="0 0 24 24"><path fill="#EA4335" d="M12 5c1.6 0 3 .6 4.1 1.6l3.1-3.1C17.3 1.8 14.8 1 12 1 7.4 1 3.5 3.6 1.6 7.4l3.7 2.9C6.2 7.1 8.9 5 12 5z"/><path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.5c-.3 1.5-1.1 2.8-2.4 3.7l3.7 2.9c2.2-2 3.7-5 3.7-8.8z"/><path fill="#FBBC05" d="M5.3 14.7c-.2-.7-.4-1.5-.4-2.7s.2-2 .4-2.7L1.6 6.4C.6 8.4 0 10.6 0 13s.6 4.6 1.6 6.6l3.7-2.9z"/><path fill="#34A853" d="M12 23c3.2 0 6-1.1 8-3l-3.7-2.9c-1.1.7-2.5 1.2-4.3 1.2-3.1 0-5.8-2.1-6.7-5.3L1.6 15C3.5 18.8 7.4 23 12 23z"/></svg>
        <span>Đăng nhập / Đăng ký nhanh bằng tài khoản Gmail</span>
      </button>
    </div>
  </div>

  <!-- ADMIN USERS, CLASSES & SUBMISSIONS MODAL -->
  <div id="adminUsersModal" class="fixed inset-0 bg-black/85 backdrop-blur-md z-50 flex items-center justify-center p-4 hidden">
    <div class="glass-card border border-slate-700 rounded-2xl w-full max-w-4xl p-6 shadow-2xl space-y-4 max-h-[85vh] flex flex-col">
      <div class="flex justify-between items-center pb-3 border-b border-slate-700">
        <h3 class="font-bold text-slate-100 flex items-center gap-2 text-sm">
          <i data-lucide="shield-check" class="w-4 h-4 text-emerald-400"></i> Bảng Điều Hành Quản Trị Hệ Thống (Đồng Bộ Cloud Online)
        </h3>
        <button onclick="toggleAdminModal(false)" class="text-slate-400 hover:text-white"><i data-lucide="x" class="w-4 h-4"></i></button>
      </div>

      <div class="flex bg-slate-950 p-1.5 rounded-xl border border-slate-800 w-fit flex-wrap gap-1">
        <button type="button" onclick="switchAdminTab('users')" id="adminTabUsersBtn" class="px-3.5 py-1.5 text-xs font-bold rounded-lg transition bg-emerald-600 text-white shadow">Người Dùng</button>
        <button type="button" onclick="switchAdminTab('classes')" id="adminTabClassesBtn" class="px-3.5 py-1.5 text-xs font-bold rounded-lg transition text-slate-400 hover:text-white">Quản Lý Lớp Học</button>
        <button type="button" onclick="switchAdminTab('submissions')" id="adminTabSubmissionsBtn" class="px-3.5 py-1.5 text-xs font-bold rounded-lg transition text-slate-400 hover:text-white">Bài Làm Đã Nộp</button>
      </div>

      <div id="adminUsersSection" class="overflow-y-auto flex-1 pr-1 space-y-2">
        <table class="w-full text-xs text-left border-collapse">
          <thead>
            <tr class="bg-slate-950 text-slate-300 uppercase text-[10px] border-b border-slate-800 font-bold">
              <th class="py-2.5 px-3">Họ và tên</th>
              <th class="py-2.5 px-3">Vai trò</th>
              <th class="py-2.5 px-3">Năm sinh</th>
              <th class="py-2.5 px-3">Lớp / Trường</th>
              <th class="py-2.5 px-3">Tài khoản / Gmail</th>
              <th class="py-2.5 px-3">Mật khẩu</th>
              <th class="py-2.5 px-3 text-right">Thao tác</th>
            </tr>
          </thead>
          <tbody id="adminUsersTableBody" class="divide-y divide-slate-800 text-slate-200"></tbody>
        </table>
      </div>

      <div id="adminClassesSection" class="overflow-y-auto flex-1 pr-1 space-y-4 hidden">
        <div class="p-4 bg-slate-950/80 rounded-xl border border-slate-800 space-y-3">
          <h4 class="text-xs font-bold uppercase text-amber-400">Tạo Lớp Học Mới & Đề Xuất Giáo Viên Từ Hệ Thống</h4>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="block text-[10px] font-bold text-slate-400 mb-1">Tên lớp học:</label>
              <input type="text" id="newClassNameInput" placeholder="Ví dụ: Lớp 9A5" class="w-full glass-input rounded-lg px-3 py-2 text-xs text-slate-100 outline-none">
            </div>
            <div>
              <label class="block text-[10px] font-bold text-slate-400 mb-1">Đề xuất giáo viên phụ trách:</label>
              <select id="newClassTeacherSelect" class="w-full glass-input rounded-lg p-2 text-xs text-slate-100 font-bold outline-none"></select>
            </div>
          </div>
          <button type="button" onclick="createClass()" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs rounded-lg transition">Tạo Lớp Ngay</button>
        </div>
        <div class="space-y-3">
          <h4 class="text-xs font-bold uppercase text-slate-300">Danh Sách Lớp Học Đã Tạo</h4>
          <div id="classListContainer" class="space-y-3"></div>
        </div>
      </div>

      <div id="adminSubmissionsSection" class="overflow-y-auto flex-1 pr-1 space-y-3 hidden">
        <p class="text-[11px] text-amber-400 italic">Bấm vào tên người dùng dưới đây để xem chi tiết nội dung và tùy chọn tải bài làm về:</p>
        <div id="submissionsListContainer" class="space-y-2"></div>
        <div id="subDetailCard" class="hidden p-4 bg-slate-900 rounded-xl border border-emerald-500/40 space-y-3">
          <div class="flex justify-between items-center">
            <span id="subDetailTitle" class="font-bold text-emerald-400 text-xs"></span>
            <div class="flex items-center gap-2">
              <button onclick="exportSelectedSubWord()" class="px-3 py-1 bg-blue-600 hover:bg-blue-500 text-white text-[11px] font-bold rounded-lg transition">Tải Word</button>
              <button onclick="exportSelectedSubPdf()" class="px-3 py-1 bg-rose-600 hover:bg-rose-500 text-white text-[11px] font-bold rounded-lg transition">Tải PDF</button>
              <button onclick="closeSubDetail()" class="text-xs text-slate-400 hover:text-white ml-2">Đóng</button>
            </div>
          </div>
          <div id="subDetailContent" class="p-3 bg-slate-950 rounded-lg text-xs font-serif whitespace-pre-wrap text-slate-200 max-h-60 overflow-y-auto border border-slate-800"></div>
        </div>
      </div>

      <div class="flex justify-between items-center pt-2 border-t border-slate-800">
        <div class="flex items-center gap-2">
          <button onclick="syncDataWithCloud(true)" class="px-3 py-2 bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold rounded-xl transition flex items-center gap-1.5">
            <i data-lucide="cloud-sync" class="w-3.5 h-3.5"></i> Đồng bộ dữ liệu Online ngay
          </button>
          <span id="syncStatusText" class="text-[10px] text-emerald-400 font-mono">Trạng thái: Sẵn sàng trực tuyến</span>
        </div>
        <button onclick="toggleAdminModal(false)" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-white text-xs font-bold rounded-xl transition">Đóng</button>
      </div>
    </div>
  </div>

  <!-- USER PROFILE MODAL -->
  <div id="userProfileModal" class="fixed inset-0 bg-black/85 backdrop-blur-md z-50 flex items-center justify-center p-4 hidden">
    <div class="glass-card border border-slate-700 rounded-2xl w-full max-w-md p-6 shadow-2xl space-y-4">
      <div class="flex justify-between items-center pb-2 border-b border-slate-700">
        <h3 class="font-bold text-slate-100 flex items-center gap-2 text-sm">
          <i data-lucide="user" class="w-4 h-4 text-emerald-400"></i> Thông Tin Tài Khoản
        </h3>
        <button onclick="toggleUserProfileModal(false)" class="text-slate-400 hover:text-white"><i data-lucide="x" class="w-4 h-4"></i></button>
      </div>
      <div class="space-y-2.5 text-xs">
        <div class="flex justify-between py-1.5 border-b border-slate-800/60">
          <span class="text-slate-400 font-semibold">Họ và tên:</span>
          <span id="profName" class="font-bold text-slate-100">-</span>
        </div>
        <div class="flex justify-between py-1.5 border-b border-slate-800/60">
          <span class="text-slate-400 font-semibold">Vai trò:</span>
          <span id="profRole" class="font-bold text-emerald-400">-</span>
        </div>
        <div class="flex justify-between py-1.5 border-b border-slate-800/60">
          <span class="text-slate-400 font-semibold">Năm sinh:</span>
          <span id="profYear" class="font-bold text-slate-200">-</span>
        </div>
        <div class="flex justify-between py-1.5 border-b border-slate-800/60">
          <span class="text-slate-400 font-semibold">Lớp:</span>
          <span id="profClass" class="font-bold text-slate-200">-</span>
        </div>
        <div class="flex justify-between py-1.5 border-b border-slate-800/60">
          <span class="text-slate-400 font-semibold">Trường:</span>
          <span id="profSchool" class="font-bold text-slate-200">-</span>
        </div>
        <div class="flex justify-between py-1.5 border-b border-slate-800/60">
          <span class="text-slate-400 font-semibold">Tài khoản / Email:</span>
          <span id="profUsername" class="font-mono text-amber-300">-</span>
        </div>
      </div>
      <div class="flex justify-end pt-2 border-t border-slate-800">
        <button onclick="toggleUserProfileModal(false)" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-white font-bold rounded-xl text-xs transition">Đóng</button>
      </div>
    </div>
  </div>

  <!-- EDIT USER MODAL -->
  <div id="editUserModal" class="fixed inset-0 bg-black/85 backdrop-blur-md z-50 flex items-center justify-center p-4 hidden">
    <div class="glass-card border border-slate-700 rounded-2xl w-full max-w-md p-6 shadow-2xl space-y-4">
      <div class="flex justify-between items-center pb-2 border-b border-slate-700">
        <h3 class="font-bold text-slate-100 flex items-center gap-2 text-sm">
          <i data-lucide="user-pen" class="w-4 h-4 text-emerald-400"></i> Chỉnh Sửa Thông Tin Người Dùng
        </h3>
        <button onclick="toggleEditUserModal(false)" class="text-slate-400 hover:text-white"><i data-lucide="x" class="w-4 h-4"></i></button>
      </div>
      <input type="hidden" id="editUserIndex">
      <input type="hidden" id="editUserUsernameKey">
      <div class="space-y-3 text-xs">
        <div>
          <label class="block font-bold text-slate-300 mb-1">Họ và tên:</label>
          <input type="text" id="editName" class="w-full glass-input rounded-xl px-3 py-2 text-slate-100 outline-none">
        </div>
        <div class="grid grid-cols-2 gap-2">
          <div>
            <label class="block font-bold text-slate-300 mb-1">Vai trò:</label>
            <select id="editRole" class="w-full glass-input rounded-xl px-3 py-2 text-slate-100 font-bold outline-none">
              <option value="Học sinh">Học sinh</option>
              <option value="Giáo viên">Giáo viên</option>
              <option value="Giáo viên (Quản trị)">Giáo viên (Quản trị)</option>
            </select>
          </div>
          <div>
            <label class="block font-bold text-slate-300 mb-1">Năm sinh:</label>
            <input type="number" id="editYear" class="w-full glass-input rounded-xl px-3 py-2 text-slate-100 outline-none">
          </div>
        </div>
        <div class="grid grid-cols-2 gap-2">
          <div>
            <label class="block font-bold text-slate-300 mb-1">Lớp:</label>
            <input type="text" id="editClass" class="w-full glass-input rounded-xl px-3 py-2 text-slate-100 outline-none">
          </div>
          <div>
            <label class="block font-bold text-slate-300 mb-1">Trường:</label>
            <input type="text" id="editSchool" class="w-full glass-input rounded-xl px-3 py-2 text-slate-100 outline-none">
          </div>
        </div>
      </div>
