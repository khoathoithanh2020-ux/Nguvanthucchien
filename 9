    function autoDetectExamStructure() {
      const examText = document.getElementById("examContent").value.trim();
      const scopeSelect = document.getElementById("evalScopeSelect");
      if (!examText) return;

      const lower = examText.toLowerCase();
      const hasReading = lower.includes("đọc hiểu") || lower.includes("phần i");
      const hasWriting = lower.includes("làm văn") || lower.includes("phần ii") || lower.includes("nghị luận") || lower.includes("viết");

      if (scopeSelect.value === "auto") {
        if (hasReading && !hasWriting) applyScopeLayout("reading_only");
        else if (!hasReading && hasWriting) applyScopeLayout("writing_only");
        else applyScopeLayout("full");
      }
    }

    function handleScopeChange() {
      const scope = document.getElementById("evalScopeSelect").value;
      if (scope === "auto") autoDetectExamStructure();
      else applyScopeLayout(scope);
    }

    function applyScopeLayout(mode) {
      const wPartI = document.getElementById("wrapperScorePartI");
