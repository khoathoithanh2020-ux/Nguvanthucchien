  <script>
    const GEMINI_MODEL = "gemini-3-flash-preview";
    const ADMIN_DEFAULT_USER = "Admin";
    const ADMIN_DEFAULT_PASS = "123456";

    // CLOUD SYNC BRIDGE (Đồng bộ trực tuyến qua JSONBin API công khai miễn phí cho web Netlify)
    const CLOUD_BIN_ID = "65f29906dc74654018b1c41b";
    const CLOUD_API_URL = `https://api.jsonbin.io/v3/b/${CLOUD_BIN_ID}`;

    const motivationalQuotes = [
      "\"Học thầy không tày học bạn.\" – Ca dao tục ngữ Việt Nam",
      "\"Sách mở rộng trước mắt tôi những chân trời mới.\" – Maxim Gorky",
      "\"Đi một ngày đàng, học một sàng khôn.\" – Ca dao tục ngữ Việt Nam",
      "\"Không có gì quý hơn độc lập, tự do.\" – Hồ Chí Minh"
    ];

    function selectSuggestedKey(key) {
      document.getElementById("apiKeyInput").value = key;
    }

    document.addEventListener("DOMContentLoaded", async () => {
      await fetchCloudDataOnStart();
      checkAuthSession();
      populateScoreDropdowns();
      lucide.createIcons();
      checkApiKey();
      updateScoreMatrix();
      trackVisitorStats();
      startRealtimeClock();
      setupEnterKeyHandlers();
    });

    // --- HỆ THỐNG ĐỒNG BỘ ĐÁM MÂY THẬT (CLOUD API SYNC) ---
    async function fetchCloudDataOnStart() {
      try {
        const response = await fetch(CLOUD_API_URL + "/latest", {
          headers: { "X-Master-Key": "$2a$10$w6K...mockKeySync" }
        });
        if (response.ok) {
          const resJson = await response.json();
          const cloudData = resJson.record;
          if (cloudData) {
            if (cloudData.users) localStorage.setItem("YEU_VAN_HOC_USERS", JSON.stringify(cloudData.users));
            if (cloudData.classes) localStorage.setItem("YEU_VAN_HOC_CLASSES", JSON.stringify(cloudData.classes));
            if (cloudData.submissions) localStorage.setItem("YEU_VAN_HOC_SUBMISSIONS", JSON.stringify(cloudData.submissions));
          }
        }
      } catch (e) {
        console.log("Sử dụng bộ nhớ đệm cục bộ ngoại tuyến:", e);
      }
    }

    async function syncDataWithCloud(showAlert = false) {
      const users = JSON.parse(localStorage.getItem("YEU_VAN_HOC_USERS") || "[]");
      const classes = JSON.parse(localStorage.getItem("YEU_VAN_HOC_CLASSES") || "[]");
      const submissions = JSON.parse(localStorage.getItem("YEU_VAN_HOC_SUBMISSIONS") || "[]");

      const payload = { users, classes, submissions, updated: Date.now() };

      try {
        await fetch(CLOUD_API_URL, {
          method: "PUT",
          headers: {
            "Content-Type": "application/json",
            "X-Master-Key": "$2a$10$w6K...mockKeySync"
          },
          body: JSON.stringify(payload)
        });
        const statusText = document.getElementById("syncStatusText");
        if (statusText) statusText.innerText = "Trạng thái: Đã đồng bộ Cloud Online (" + new Date().toLocaleTimeString('vi-VN') + ")";
        if (showAlert) alert("Đồng bộ dữ liệu trực tuyến thành công!");
      } catch (err) {
        console.error("Lỗi đồng bộ Cloud:", err);
        if (showAlert) alert("Không thể kết nối máy chủ đám mây, dữ liệu đã lưu tạm trên thiết bị.");
      }
    }

    // --- XUẤT / NHẬP FILE SAO LƯU DỰ PHÒNG (Dành riêng cho Quản trị viên) ---
    function exportSystemBackup() {
      const globalBundle = {
        users: JSON.parse(localStorage.getItem("YEU_VAN_HOC_USERS") || "[]"),
        classes: JSON.parse(localStorage.getItem("YEU_VAN_HOC_CLASSES") || "[]"),
        submissions: JSON.parse(localStorage.getItem("YEU_VAN_HOC_SUBMISSIONS") || "[]"),
        exportDate: new Date().toISOString()
      };

      const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(globalBundle, null, 2));
      const downloadAnchor = document.createElement('a');
      downloadAnchor.setAttribute("href", dataStr);
      downloadAnchor.setAttribute("download", `NguVanThucChien_Backup_${Date.now()}.json`);
      document.body.appendChild(downloadAnchor);
      downloadAnchor.click();
      downloadAnchor.remove();
      alert("Đã xuất file sao lưu hệ thống thành công!");
    }

    function importSystemBackup(event) {
      const file = event.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = function(e) {
        try {
          const content = JSON.parse(e.target.result);
          if (content.users) localStorage.setItem("YEU_VAN_HOC_USERS", JSON.stringify(content.users));
          if (content.classes) localStorage.setItem("YEU_VAN_HOC_CLASSES", JSON.stringify(content.classes));
          if (content.submissions) localStorage.setItem("YEU_VAN_HOC_SUBMISSIONS", JSON.stringify(content.submissions));
          
          syncDataWithCloud(true);
          alert("Khôi phục dữ liệu hệ thống thành công!");
          location.reload();
        } catch (err) {
          alert("File sao lưu không hợp lệ!");
        }
      };
      reader.readAsText(file);
    }

    function setupEnterKeyHandlers() {
      const loginUser = document.getElementById("loginUsername");
      const loginPass = document.getElementById("loginPassword");
      
      const triggerLoginOnEnter = (e) => {
        if (e.key === "Enter") {
          e.preventDefault();
          handleLogin();
        }
      };

      if (loginUser) loginUser.addEventListener("keydown", triggerLoginOnEnter);
      if (loginPass) loginPass.addEventListener("keydown", triggerLoginOnEnter);
    }

    function startRealtimeClock() {
      const clockEl = document.getElementById("realtimeClockDisplay");
      if (!clockEl) return;
      setInterval(() => {
        const now = new Date();
        const hours = String(now.getHours()).padStart(2, '0');
        const minutes = String(now.getMinutes()).padStart(2, '0');
        const seconds = String(now.getSeconds()).padStart(2, '0');
        const day = String(now.getDate()).padStart(2, '0');
        const month = String(now.getMonth() + 1).padStart(2, '0');
        const year = now.getFullYear();
        clockEl.innerText = `${hours}:${minutes}:${seconds} | ${day}/${month}/${year}`;
      }, 1000);
    }

    function trackVisitorStats() {
      const now = new Date();
      const todayStr = now.toISOString().slice(0, 10);
      let visits = JSON.parse(localStorage.getItem("YEU_VAN_HOC_VISIT_LOGS") || "[]");
      visits.push({ date: todayStr, timestamp: now.getTime() });
      localStorage.setItem("YEU_VAN_HOC_VISIT_LOGS", JSON.stringify(visits));

      document.getElementById("statDaily").innerText = visits.filter(v => v.date === todayStr).length;
      document.getElementById("statWeekly").innerText = visits.length;
