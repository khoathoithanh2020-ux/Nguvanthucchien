      localStorage.setItem("YEU_VAN_HOC_CURRENT_USER", JSON.stringify(newUser));
      syncDataWithCloud(); // Đồng bộ ngay lên Cloud để Admin máy khác thấy được

      alert("Đăng ký thành công! Dữ liệu đã được lưu trực tuyến.");
