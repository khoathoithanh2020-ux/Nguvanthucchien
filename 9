      wPartI.style.display = "block";
      wPartII_Q1.style.display = "block";
      wPartII_Q2.style.display = "block";
      secReading.style.display = "block";
      secWriting.style.display = "block";
      wWritingQ1.style.display = "block";
      wWritingQ2.style.display = "block";
