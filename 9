    function checkAuthSession() {
      const currentUser = localStorage.getItem("YEU_VAN_HOC_CURRENT_USER");
      const authModal = document.getElementById("authModal");
      const headerUserName = document.getElementById("headerUserName");
      const dropdownUserEmail = document.getElementById("dropdownUserEmail");
      const dropdownAdminBtn = document.getElementById("dropdownAdminUsersBtn");
      const studentClassBtn = document.getElementById("studentClassBtn");
      const adminBackupTools = document.getElementById("adminBackupTools");

      if (currentUser) {
        const userObj = JSON.parse(currentUser);
        authModal.classList.add("hidden");
        headerUserName.innerText = `${userObj.name} (${userObj.role})`;
        if (dropdownUserEmail) dropdownUserEmail.innerText = userObj.username || userObj.email || userObj.name;

        const isAdmin = (userObj.username && userObj.username.toLowerCase() === ADMIN_DEFAULT_USER.toLowerCase()) || (userObj.email && userObj.email.toLowerCase() === ADMIN_DEFAULT_USER.toLowerCase()) || userObj.role?.includes("Quản trị");

        if (isAdmin || userObj.role.includes("Giáo viên")) {
          if (dropdownAdminBtn) dropdownAdminBtn.classList.remove("hidden");
          if (studentClassBtn) studentClassBtn.classList.add("hidden");
          // Chỉ hiển thị mục sao lưu và khôi phục cho tài khoản Quản trị / Giáo viên
          if (adminBackupTools) {
            adminBackupTools.classList.remove("hidden");
            adminBackupTools.classList.add("flex");
          }
        } else {
          if (dropdownAdminBtn) dropdownAdminBtn.classList.add("hidden");
          if (studentClassBtn) {
            studentClassBtn.classList.remove("hidden");
            studentClassBtn.classList.add("flex");
          }
          // Ẩn hoàn toàn mục sao lưu đối với học sinh
          if (adminBackupTools) {
            adminBackupTools.classList.add("hidden");
            adminBackupTools.classList.remove("flex");
          }
        }
      } else {
        authModal.classList.remove("hidden");
      }
    }

