    function resetUserPassword(username, idx) {
      const currentUser = JSON.parse(localStorage.getItem("YEU_VAN_HOC_CURRENT_USER") || "{}");
      const isAdmin = (currentUser.username && currentUser.username.toLowerCase() === ADMIN_DEFAULT_USER.toLowerCase()) || currentUser.role?.includes("Quản trị");
      if (!isAdmin) {
        alert("Chỉ có Quản trị viên mới có quyền đặt lại mật khẩu người dùng!");
        return;
      }
      const newPass = prompt(`Nhập mật khẩu mới cho tài khoản "${username}":`);
      if (!newPass) return;
      if (idx === 0) {
        alert("Không thể đổi mật khẩu tài khoản quản trị mặc định qua bảng này!");
        return;
      }

      let registeredUsers = JSON.parse(localStorage.getItem("YEU_VAN_HOC_USERS") || "[]");
      const userIndex = registeredUsers.findIndex(u => u.username === username || u.email === username);
      if (userIndex !== -1) {
        registeredUsers[userIndex].password = newPass;
        localStorage.setItem("YEU_VAN_HOC_USERS", JSON.stringify(registeredUsers));
        syncDataWithCloud();
        renderAdminUsersList();
        alert(`Đã đặt lại mật khẩu mới cho tài khoản "${username}" thành công!`);
      }
    }

