    function setSelectScore(selectId, scoreVal) {
      const el = document.getElementById(selectId);
      if (!el) return;
      for (let i = 0; i < el.options.length; i++) {
        if (Math.abs(parseFloat(el.options[i].value) - scoreVal) < 0.01) {
          el.selectedIndex = i;
          return;
        }
      }
    }

