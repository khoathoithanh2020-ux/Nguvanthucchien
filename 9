    function getCombinedStudentWork() {
      const scope = document.getElementById("evalScopeSelect").value;
      let text = "";
      let hasContent = false;
      const readingItems = document.querySelectorAll(".reading-q-item");
      const v1 = document.getElementById("ans_viet_1").value.trim();
      const v2 = document.getElementById("ans_viet_2").value.trim();

      if (scope === "reading_only" || scope === "full" || scope === "auto") {
        text += "PHẦN I. ĐỌC HIỂU:\n";
        readingItems.forEach((item, idx) => {
          const val = item.querySelector("input").value.trim();
          text += `Câu ${idx + 1}: ${val || "(Chưa trả lời)"}\n`;
          if (val) hasContent = true;
        });
      }

      if (scope === "writing_only" || scope === "full" || scope === "auto") {
        text += "\nPHẦN II. VIẾT:\n";
        text += `Câu 1:\n${v1 || "(Chưa làm)"}\n\n`;
        text += `Câu 2:\n${v2 || "(Chưa làm)"}`;
        if (v1 || v2) hasContent = true;
      } else if (scope === "writing_q1_only") {
        text += "\nPHẦN II - CÂU 1 (Đoạn văn):\n" + (v1 || "(Chưa làm)");
        if (v1) hasContent = true;
      } else if (scope === "writing_q2_only") {
        text += "\nPHẦN II - CÂU 2 (Bài văn):\n" + (v2 || "(Chưa làm)");
        if (v2) hasContent = true;
      }

      return { combinedText: text.trim(), hasContent: hasContent };
    }

