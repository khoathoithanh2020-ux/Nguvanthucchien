      const newUser = { role, year, name, className, school, username, email: username, password };
      let registeredUsers = JSON.parse(localStorage.getItem("YEU_VAN_HOC_USERS") || "[]");
      
      if (registeredUsers.some(u => u.username === username)) {
        alert("Tài khoản hoặc Email này đã tồn tại trong hệ thống!");
