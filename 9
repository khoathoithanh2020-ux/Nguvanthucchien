    function populateScoreDropdowns() {
      const selects = [
        { id: "scorePartI", defaultVal: 4.0 },
        { id: "scorePartII_Q1", defaultVal: 2.0 },
        { id: "scorePartII_Q2", defaultVal: 4.0 }
      ];
      selects.forEach(item => {
        const el = document.getElementById(item.id);
        el.innerHTML = "";
        for (let val = 0.0; val <= 10.0; val += 0.25) {
          const opt = document.createElement("option");
          opt.value = val.toFixed(2);
          opt.innerText = `${val.toFixed(2).replace(/\.00$/, '.0')} điểm`;
          if (Math.abs(val - item.defaultVal) < 0.01) opt.selected = true;
          el.appendChild(opt);
        }
      });
    }

